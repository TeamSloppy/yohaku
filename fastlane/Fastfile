require "shellwords"
require "fileutils"

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"

default_platform(:ios)

APP_IDENTIFIER = "team.sloppy.yohaku"
ROOT_DIR = File.expand_path("..", __dir__)
PROJECT = "Yohaku.xcodeproj"
SCHEME = "Yohaku"
DEFAULT_VERSION = "0.1.0"

def required_env(name)
  value = ENV[name]
  UI.user_error!("Set #{name} before running this lane") if value.to_s.strip.empty?
  value
end

def numeric_version(value, name)
  UI.user_error!("#{name} must contain only digits and dots") unless value.match?(/\A\d+(?:\.\d+)*\z/)
  value
end

def app_store_connect_key
  key_filepath = ENV["ASC_KEY_FILEPATH"]
  key_content = ENV["ASC_KEY_BASE64"]

  if key_filepath.to_s.empty? == key_content.to_s.empty?
    UI.user_error!("Set exactly one of ASC_KEY_FILEPATH or ASC_KEY_BASE64")
  end

  options = {
    key_id: required_env("ASC_KEY_ID"),
    issuer_id: required_env("ASC_ISSUER_ID")
  }

  if key_filepath.to_s.empty?
    options[:key_content] = key_content
    options[:is_key_content_base64] = true
  else
    options[:key_filepath] = File.expand_path(key_filepath)
  end

  app_store_connect_api_key(**options)
end

def build_ipa(version:, build_number:)
  version = numeric_version(version, "MARKETING_VERSION")
  build_number = numeric_version(build_number, "BUILD_NUMBER")

  sh("xcodegen", "generate", "--spec", File.join(ROOT_DIR, "project.yml"))

  output_directory = File.join(ROOT_DIR, "build/fastlane")
  archive_path = File.join(output_directory, "Yohaku.xcarchive")
  final_ipa_path = File.join(output_directory, "Yohaku-#{version}-#{build_number}.ipa")

  build_app(
    project: File.join(ROOT_DIR, PROJECT),
    scheme: SCHEME,
    configuration: "Release",
    clean: true,
    skip_package_ipa: true,
    archive_path: archive_path,
    derived_data_path: File.join(ROOT_DIR, "build/fastlane/DerivedData"),
    xcargs: [
      "-allowProvisioningUpdates",
      "MARKETING_VERSION=#{Shellwords.escape(version)}",
      "CURRENT_PROJECT_VERSION=#{Shellwords.escape(build_number)}"
    ].join(" ")
  )

  # Fastlane 2.226 does not understand Xcode 26's `app-store-connect` export
  # method, so archive with gym and let the installed Xcode export the IPA.
  export_directory = File.join(output_directory, "export")
  export_options_path = File.join(output_directory, "ExportOptions.plist")
  FileUtils.rm_rf(export_directory)
  FileUtils.mkdir_p(export_directory)
  File.write(export_options_path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>destination</key><string>export</string>
      <key>method</key><string>app-store-connect</string>
      <key>manageAppVersionAndBuildNumber</key><false/>
      <key>signingStyle</key><string>automatic</string>
      <key>teamID</key><string>8PYCRS3EA3</string>
      <key>uploadSymbols</key><true/>
    </dict>
    </plist>
  PLIST

  sh(
    "xcodebuild",
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", export_directory,
    "-exportOptionsPlist", export_options_path,
    "-allowProvisioningUpdates"
  )

  exported_ipa = Dir[File.join(export_directory, "*.ipa")].first
  UI.user_error!("Archive succeeded, but Xcode did not export an IPA") unless exported_ipa
  FileUtils.rm_f(final_ipa_path)
  FileUtils.mv(exported_ipa, final_ipa_path)
  final_ipa_path
end

platform :ios do
  desc "Build an App Store IPA without uploading it"
  lane :build do
    version = ENV.fetch("MARKETING_VERSION", DEFAULT_VERSION)
    build_number = ENV.fetch("BUILD_NUMBER", "1")
    build_ipa(version: version, build_number: build_number)
  end

  desc "Build and upload the next build to TestFlight"
  lane :beta do
    version = numeric_version(ENV.fetch("MARKETING_VERSION", DEFAULT_VERSION), "MARKETING_VERSION")
    api_key = app_store_connect_key
    build_number = ENV["BUILD_NUMBER"] || (
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        version: version,
        initial_build_number: 0
      ) + 1
    ).to_s

    ipa_path = build_ipa(version: version, build_number: build_number)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
